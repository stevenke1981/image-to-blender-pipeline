{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluated Blender gait animation samples v1.0",
  "description": "m/s/radians; foot positions and probes in world space; matrices in armature space; root motion separately. All samples including duplicated closing pose.",
  "type": "array",
  "minItems": 2,
  "items": {
    "type": "object",
    "required": [
      "time_s",
      "root",
      "com",
      "pelvis_rotation_rad",
      "feet",
      "pelvis_matrix",
      "bone_matrices"
    ],
    "properties": {
      "time_s": {
        "type": "number"
      },
      "root": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "com": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "pelvis_rotation_rad": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "feet": {
        "type": "object",
        "minProperties": 2,
        "additionalProperties": {
          "type": "object",
          "required": [
            "position",
            "stance",
            "joint_angles_rad",
            "ground_probe_z_m"
          ],
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "stance": {
              "type": "boolean"
            },
            "joint_angles_rad": {
              "type": "object",
              "required": [
                "hip",
                "knee",
                "ankle"
              ],
              "properties": {
                "hip": {
                  "type": "number"
                },
                "knee": {
                  "type": "number"
                },
                "ankle": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "ground_probe_z_m": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "pelvis_matrix": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "bone_matrices": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "additionalProperties": false
  }
}
